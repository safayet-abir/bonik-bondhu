# Copy to .env and fill in. Never commit .env (TRD §6, Security §5).
APP_ENV=development
DATABASE_URL=postgresql+psycopg://bb:bb@localhost:5432/bonik_bondhu
# Separate database used by pytest (it is wiped/seeded by tests)
TEST_DATABASE_URL=postgresql+psycopg://bb:bb@localhost:5432/bonik_bondhu_test
# 32+ random bytes as hex, used to salt IP hashes in audit_logs
SECRET_SALT=
CORS_ORIGINS=http://localhost:5173
OWNER_SESSION_DAYS=7
LENDER_SESSION_HOURS=8
# gemini | none  (none = non-LLM fallbacks; the core app works fully)
LLM_PROVIDER=none
GEMINI_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=20
AI_DAILY_LIMIT_ADVISOR=30
AI_DAILY_LIMIT_EXTRACTION=10
AI_DAILY_LIMIT_PURPOSE=10
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5
FORECAST_WINDOW_WEEKS=8
FORECAST_MIN_WEEKS=4
HIGH_DEPENDENCY_SHARE=0.50
# Only used by `python -m app.cli seed-demo`
DEMO_PASSWORD=
LOG_LEVEL=INFO
