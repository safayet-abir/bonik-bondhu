# Copy to .env and fill in. Never commit .env (TRD §6, Security §5).
APP_ENV=development
DATABASE_URL=postgresql+psycopg://bb:bb@localhost:5432/bonik_bondhu
# Separate database used by pytest (it is wiped/seeded by tests)
TEST_DATABASE_URL=postgresql+psycopg://bb:bb@localhost:5432/bonik_bondhu_test
# 32+ random bytes as hex, used to salt IP hashes in audit_logs
SECRET_SALT=
CORS_ORIGINS=http://localhost:5173
OWNER_SESSION_DAYS=7
LENDER_SESSION_HOURS=8
# gemini | groq | none  (none = non-LLM fallbacks; the core app works fully).
# The provider named first is tried first; the other key (if set) is the fallback for
# text features. Receipt photos need Gemini (vision). Keys stay on the server only.
LLM_PROVIDER=none
GEMINI_API_KEY=
LLM_MODEL=gemini-flash-lite-latest
LLM_VISION_MODEL=gemini-flash-latest
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
LLM_TIMEOUT_SECONDS=20
AI_DAILY_LIMIT_ADVISOR=30
AI_DAILY_LIMIT_EXTRACTION=10
AI_DAILY_LIMIT_PURPOSE=10
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5
FORECAST_WINDOW_WEEKS=8
FORECAST_MIN_WEEKS=4
HIGH_DEPENDENCY_SHARE=0.50
# Daily automatic news search inside the app (SUG-45); 0 = off. Production demo: 24
NEWS_FETCH_HOURS=0
# Only used by `python -m app.cli seed-demo`
DEMO_PASSWORD=
LOG_LEVEL=INFO
